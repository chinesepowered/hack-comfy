{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "lidarlab_sample.mp4"
    },
    "_meta": {
      "title": "Input clip"
    }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0.0,
      "duration": 8.0,
      "strict_duration": false
    },
    "_meta": {
      "title": "Trim"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Frames + audio + fps"
    }
  },
  "4": {
    "class_type": "ImageScaleToMaxDimension",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "upscale_method": "area",
      "largest_size": 1280
    },
    "_meta": {
      "title": "Working resolution"
    }
  },
  "5": {
    "class_type": "LoadBackgroundRemovalModel",
    "inputs": {
      "bg_removal_name": "birefnet.safetensors"
    },
    "_meta": {
      "title": "BiRefNet"
    }
  },
  "6": {
    "class_type": "LidarLabBiRefNetMatte",
    "inputs": {
      "bg_removal_model": [
        "5",
        0
      ],
      "images": [
        "4",
        0
      ],
      "resolution": 768,
      "stride": 2
    },
    "_meta": {
      "title": "Subject matte (any camera)"
    }
  },
  "7": {
    "class_type": "LoadDA3Model",
    "inputs": {
      "model_name": "depth_anything_3_mono_large.safetensors",
      "weight_dtype": "bf16"
    },
    "_meta": {
      "title": "Depth Anything 3"
    }
  },
  "8": {
    "class_type": "LidarLabVideoDepth",
    "inputs": {
      "da3_model": [
        "7",
        0
      ],
      "images": [
        "4",
        0
      ],
      "resolution": 504,
      "frame_stride": 1,
      "temporal_smoothing": 0.6
    },
    "_meta": {
      "title": "Video depth"
    }
  },
  "9": {
    "class_type": "LidarLabBulletTime",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "masks": [
        "6",
        0
      ],
      "da3_geometry": [
        "8",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "freeze_at": -1.0,
      "duration": 2.2,
      "angle": 14.0,
      "zoom": 0.35,
      "ramp": 0.5,
      "flash": true,
      "motion_blur": true,
      "relief": 0.25,
      "fov": 60.0
    },
    "_meta": {
      "title": "Bullet Time"
    }
  },
  "10": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "9",
        0
      ],
      "fps": [
        "3",
        2
      ]
    },
    "_meta": {
      "title": "Encode"
    }
  },
  "11": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "10",
        0
      ],
      "filename_prefix": "lidarlab/bullet_time",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
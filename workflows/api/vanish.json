{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "example.mp4"
    },
    "_meta": {
      "title": "Input clip"
    }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0.0,
      "duration": 8.0,
      "strict_duration": false
    },
    "_meta": {
      "title": "Trim"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Frames + audio + fps"
    }
  },
  "4": {
    "class_type": "ImageScaleToMaxDimension",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "upscale_method": "area",
      "largest_size": 1280
    },
    "_meta": {
      "title": "Working resolution"
    }
  },
  "5": {
    "class_type": "LidarLabCleanPlate",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "max_samples": 64,
      "refine": 2
    },
    "_meta": {
      "title": "Clean plate"
    }
  },
  "6": {
    "class_type": "LidarLabSubjectMatte",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "plate": [
        "5",
        0
      ],
      "threshold": 0.1,
      "softness": 1.0,
      "grow": 2,
      "max_subjects": 2
    },
    "_meta": {
      "title": "Subject matte"
    }
  },
  "7": {
    "class_type": "LidarLabVanish",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "masks": [
        "6",
        0
      ],
      "plate": [
        "5",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "start": 0.8,
      "duration": 2.0,
      "direction": "left to right",
      "particles": "ash",
      "color": "#ff7a2f",
      "wind_angle": -20.0,
      "wind_speed": 1.0,
      "turbulence": 1.0,
      "density": 0.45,
      "freeze_subject": true,
      "seed": 0
    },
    "_meta": {
      "title": "Vanish"
    }
  },
  "8": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "7",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "audio": [
        "3",
        1
      ]
    },
    "_meta": {
      "title": "Encode"
    }
  },
  "9": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "8",
        0
      ],
      "filename_prefix": "lidarlab/vanish",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save"
    }
  }
}
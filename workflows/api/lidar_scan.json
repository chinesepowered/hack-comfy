{
  "1": {
    "class_type": "LoadVideo",
    "inputs": {
      "file": "lidarlab_sample.mp4"
    },
    "_meta": {
      "title": "Input clip"
    }
  },
  "2": {
    "class_type": "Video Slice",
    "inputs": {
      "video": [
        "1",
        0
      ],
      "start_time": 0.0,
      "duration": 8.0,
      "strict_duration": false
    },
    "_meta": {
      "title": "Trim"
    }
  },
  "3": {
    "class_type": "GetVideoComponents",
    "inputs": {
      "video": [
        "2",
        0
      ]
    },
    "_meta": {
      "title": "Frames + audio + fps"
    }
  },
  "4": {
    "class_type": "ImageScaleToMaxDimension",
    "inputs": {
      "image": [
        "3",
        0
      ],
      "upscale_method": "area",
      "largest_size": 1280
    },
    "_meta": {
      "title": "Working resolution"
    }
  },
  "5": {
    "class_type": "LoadDA3Model",
    "inputs": {
      "model_name": "depth_anything_3_mono_large.safetensors",
      "weight_dtype": "bf16"
    },
    "_meta": {
      "title": "Depth Anything 3"
    }
  },
  "6": {
    "class_type": "DA3Inference",
    "inputs": {
      "da3_model": [
        "5",
        0
      ],
      "image": [
        "4",
        0
      ],
      "resolution": 504,
      "resize_method": "upper_bound_resize",
      "mode": "mono"
    },
    "_meta": {
      "title": "Video depth"
    }
  },
  "7": {
    "class_type": "LidarLabStabilizeDepth",
    "inputs": {
      "da3_geometry": [
        "6",
        0
      ],
      "temporal_smoothing": 0.6
    },
    "_meta": {
      "title": "Stabilize depth"
    }
  },
  "8": {
    "class_type": "LidarLabScan",
    "inputs": {
      "images": [
        "4",
        0
      ],
      "da3_geometry": [
        "7",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "style": "cyan",
      "color": "#4de1ff",
      "sweep": "depth (near to far)",
      "scan_start": 0.6,
      "scan_duration": 1.6,
      "hold": 2.4,
      "camera": "orbit",
      "camera_amount": 0.6,
      "return_to_video": true,
      "density": 4,
      "glow": 1.0,
      "fov": 60.0,
      "drop_sky": true
    },
    "_meta": {
      "title": "LiDAR Scan"
    }
  },
  "9": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": [
        "8",
        0
      ],
      "fps": [
        "3",
        2
      ],
      "audio": [
        "3",
        1
      ]
    },
    "_meta": {
      "title": "Encode"
    }
  },
  "10": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": [
        "9",
        0
      ],
      "filename_prefix": "lidarlab/lidar_scan",
      "format": "auto",
      "codec": "auto"
    },
    "_meta": {
      "title": "Save"
    }
  }
}